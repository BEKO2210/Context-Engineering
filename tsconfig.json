{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": false
  },
  "include": [
    "src/**/*.ts",
    "benchmarks/**/*.ts",
    "tools/**/*.ts",
    "examples/context-minimal/src/**/*.ts",
    "examples/context-minimal/tests/**/*.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
